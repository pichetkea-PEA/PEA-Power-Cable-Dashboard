rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Rules for Central Database assets cache and config
    match /admin_central_db/{docId} {
      allow read, write: if true;
    }

    // 2. Rules for sector_spreadsheets mapping
    match /sector_spreadsheets/{sectorId} {
      allow read, write: if true;
    }

    // 3. Rules for registered users management
    match /registered_users/{userId} {
      allow read, write: if true;
    }

    // Global Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
